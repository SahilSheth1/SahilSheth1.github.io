---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="That page doesn't exist.">
  <section class="wrap">
    <div class="container content">
      <p class="mono-label">Error 404 / signal lost</p>
      <h1 class="display">404</h1>
      <p class="lede">
        That page doesn't exist. It may have moved, or the link may be wrong.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/">
          Back to home
        </a>
        <a class="btn btn-secondary" href="/music">
          Listen to music
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .wrap {
    display: grid;
    align-content: center;
    min-height: calc(100svh - var(--nav-height) - 6rem);
  }

  .content {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8);
  }

  .lede {
    max-width: 40ch;
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .actions .btn {
    background-image: none;
  }
</style>
