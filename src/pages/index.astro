---
import Layout from "../layouts/Layout.astro";
import SectionStub from "../components/SectionStub.astro";

const sections = [
  { id: "about", title: "About" },
  { id: "projects", title: "Projects" },
  { id: "career", title: "Career and education" },
  { id: "skills", title: "Skills" },
  { id: "resume", title: "Resume" },
  { id: "contact", title: "Contact" },
];
---

<Layout>
  <section class="hero">
    <div class="container content">
      <p class="mono-label">Software / Design / Music</p>
      <h1 class="display">Sahil Sheth</h1>
      <p class="lede">
        I engineer intelligent tools from the ground up—developing predictive
        models and crafting the seamless user interfaces that power them. In the
        studio, I compose and produce digital music using Logic Pro.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#projects">
          View projects
        </a>
        <a class="btn btn-secondary" href="/music">
          Listen to music
        </a>
      </div>
    </div>
  </section>

  {sections.map((s, i) => (
    <SectionStub
      id={s.id}
      index={String(i + 1).padStart(2, "0")}
      title={s.title}
      note="Content arrives in Phase 3."
    />
  ))}
</Layout>

<style>
  .hero {
    display: grid;
    align-content: center;
    min-height: calc(100svh - var(--nav-height));
    background: radial-gradient(
      60% 50% at 85% 0%,
      var(--accent-soft),
      transparent 70%
    );
  }

  .content {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-9);
  }

  .lede {
    max-width: 44ch;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .actions .btn {
    background-image: none;
  }
</style>
