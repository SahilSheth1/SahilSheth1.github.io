---
import Layout from "../layouts/Layout.astro";
import About from "../components/sections/About.astro";
import Projects from "../components/sections/Projects.astro";
import Career from "../components/sections/Career.astro";
import Skills from "../components/sections/Skills.astro";
import Resume from "../components/sections/Resume.astro";
import Contact from "../components/sections/Contact.astro";
import Pad from "../components/Pad.astro";
---

<Layout>
  <section class="hero">
    <div class="container content">
      <p class="mono-label">Software / Design / Music</p>
      <h1 class="display">Sahil Sheth</h1>
      <p class="lede">
        I build predictive models and the interfaces that go with them. I also
        produce music in Logic Pro, start to finish.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#projects">
          View projects
        </a>
        <a class="btn btn-secondary" href="/music">
          Listen to music
        </a>
      </div>
      <Pad />
    </div>
  </section>

  <About />
  <Projects />
  <Career />
  <Skills />
  <Resume />
  <Contact />
</Layout>

<style>
  .hero {
    display: grid;
    align-content: center;
    min-height: calc(100svh - var(--nav-height));
    background: radial-gradient(
      60% 50% at 85% 0%,
      var(--accent-soft),
      transparent 70%
    );
  }

  .content {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-9);
  }

  .lede {
    max-width: 44ch;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .actions .btn {
    background-image: none;
  }

  /* Wide screens: text on the left, the pad on the right */
  @media (min-width: 64rem) {
    .content {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      grid-template-rows: 1fr repeat(4, auto) 1fr;
      column-gap: var(--space-8);
    }

    .content > :not(:global(.pad)) {
      grid-column: 1;
    }

    .content > :global(.pad) {
      grid-column: 2;
      grid-row: 1 / span 6;
      align-self: center;
      justify-self: end;
    }
  }
</style>
